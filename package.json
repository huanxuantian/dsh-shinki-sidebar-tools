{
  "name": "dsh-shinki-sidebar-tools",
  "version": "0.2.2",
  "description": "DSH 右侧边栏增强：① tab 条可滚动（可见细滚动条 + 放开触摸平移）；② 在「+」控件区右键弹出「创建视图」菜单（列出已注册视图与内置视图），并往「+」打开的指南里注入创建入口。零注入、纯客户端、失败不影响宿主。",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-modules", "@deepseek-ai/dsh-client-locale"], "platform": "web" }
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "keywords": ["dsh", "dsh-plugin", "sidebar", "scroll", "tabs", "view"],
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test" }
}
